# Copy this file to ".env" and fill in real values.
# IMPORTANT: never commit the real ".env" file (it is gitignored).

# Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# One-time recovery operator variables; NOT needed in Vercel runtime.
# db:admin:init never overwrites existing accounts. Remove after initialization.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ADMIN_PASSWORD: generated 16-256 chars with upper/lower case, digit, symbol.

# Required in production: >=32 cryptographically random characters, server-only.
AUTH_SECRET=

# Public site URL (used for SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://kashmirdecor.uz
 
