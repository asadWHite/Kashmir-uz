# Copy this file to ".env" and fill in real values.
# IMPORTANT: never commit the real ".env" file (it is gitignored).

# Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin login (server-side only; never exposed to the browser)
ADMIN_EMAIL=admin@kashmirdecor.com
ADMIN_PASSWORD=change-this-password

# Secret used to sign admin session cookies (use a long random string)
AUTH_SECRET=replace-with-a-long-random-secret

# Public site URL (used for SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://kashmirdecor.com
